# Postgres. En local: postgresql://usuario@localhost:5432/mybooks_dev
# En producción, la que da Neon (contiene neon.tech).
DATABASE_URL=

# La contraseña con la que entrás a /admin.
ADMIN_PASSWORD=

# Secreto para firmar la cookie de sesión.
# Generalo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
